# Copy to .env (local file, NOT committed - see .gitignore).
# --- Discord notifications ---
# Full webhook URL (secret). Empty = notifications disabled (no crash).
# Keep the real value in a password manager / vault - never in the repo.
# In a Discord webhook URL the token is a secret; the .env entry itself is local.
DISCORD_WEBHOOK_URL=
# Optional: overridden sender name for messages
# DISCORD_USERNAME=yt2abs
# Disable sending even when a URL is set (1/true/yes/on);
# the global NOTIFY_DISABLED=1 is honoured too
# DISCORD_NOTIFY_DISABLED=0
# Request timeout in seconds (default 10)
# DISCORD_NOTIFY_TIMEOUT=10
# Which events to send: imported,retry,failed | all | none
# (default imported,failed). Note: a change in the WebUI panel (/settings)
# overrides this variable - the panel selection is persistent (settings table in SQLite).
# DISCORD_NOTIFY_EVENTS=imported,failed

# --- ntfy: notifications for errors ONLY (failed/deleted) ---
# Empty NTFY_TOPIC = channel disabled (zero HTTP requests).
NTFY_TOPIC=
# ntfy server (default https://ntfy.sh). Can be given without a scheme.
# IMPORTANT: server root only - path/query/fragment/userinfo are rejected;
# the topic is provided only in NTFY_TOPIC.
# NTFY_URL=https://ntfy.sh
# Token for protected topics (Authorization: Bearer header).
# NTFY_TOKEN=
# Disable sending even when a topic is set (1/true/yes/on);
# the global NOTIFY_DISABLED=1 is honoured too.
# NTFY_NOTIFY_DISABLED=0
# Request timeout in seconds (default 10).
# NTFY_NOTIFY_TIMEOUT=10
# Which errors to send: failed,deleted | all | none (default failed,deleted).
# NTFY_NOTIFY_EVENTS=failed,deleted

# --- yt2abs service (docker compose) ---
# Image: local build (default) or a tag from CI, e.g.
# ghcr.io/damianeek/yt2abs-public:dev or :latest (requires docker login for a private package).
# YT2ABS_IMAGE=ghcr.io/damianeek/yt2abs-public:dev
# Audiobookshelf API key (Settings -> API Keys); NEVER commit .env.
ABS_API_KEY=
# "YouTube" podcast library id (GET /api/libraries).
ABS_LIBRARY_ID=
# ABS address as seen from the yt2abs container.
ABS_URL=http://192.168.1.10:13378
# ABS account whose progress protects unfinished episodes (name or id).
# Empty = all accounts via /api/users (requires an admin key).
# ABS_PROGRESS_USER=
# No authentication: yt2abs is LAN-only, the port is the access control.
# Do not publish the port outside your own network.  Bind to one LAN address
# (see YT2ABS_BIND_ADDR below) and keep the reverse proxy ACL in place.
# Public HTTPS address of the reverse proxy, used only to build the bookmarklet
# link and to keep redirects on https (e.g. https://yt2abs.example.com).
# Extra dotted host names (comma-separated). IP literals, localhost and
# single-label names are accepted without this entry.
YT2ABS_ALLOWED_HOSTS=
YT2ABS_PUBLIC_URL=
# Playlist polling kill switch ("add from phone"): 0/false disables.
# 1/true = no change; does NOT enable the playlist (playlist.enabled decides).
# YT2ABS_PLAYLIST_ENABLED=0
# Request limit per minute per client IP (API / public bookmarklet).
YT2ABS_API_RATE_LIMIT=60
YT2ABS_PUBLIC_RATE_LIMIT=10
# Retention: 1 = report only (dry run), without writes or deletions.
# YT2ABS_RETENTION_DRY_RUN=0
# X-Forwarded-For headers are honoured only from addresses in this list (CIDR).
# Enter the EXACT proxy address as /32 - the same one you see as `client_addr`
# in the access log, e.g. 10.1.2.1/32. An entry with host bits (10.1.2.1/8) is
# rejected, and a prefix shorter than /16 (IPv4) / /48 (IPv6) warns.
# Empty = headers ignored (a client cannot impersonate another IP).
# TRUST_PROXY=1 without a list trusts every peer (startup warning).
YT2ABS_TRUST_PROXY=0
YT2ABS_TRUSTED_PROXIES=
# A list covering ALL (0.0.0.0/0, ::/0 or 0.0.0.0/1 + 128.0.0.0/1) makes the
# client choose its own rate-limit bucket; it warns at startup.  Set 1 only
# deliberately if you accept that risk.
# YT2ABS_TRUST_ANY_PEER=0
# Listen address of the published port: 127.0.0.1 = host only (default),
# e.g. 192.168.1.10 = LAN only. Do not expose on 0.0.0.0 without an ACL on the port.
YT2ABS_BIND_ADDR=127.0.0.1
# Unraid: nobody:users. Locally: PUID=$(id -u) PGID=$(id -g)
PUID=99
PGID=100
# HTTP port on the host.
YT2ABS_HTTP_PORT=8099
# Host paths mounted into the container (the library must be the same as in ABS).
YT2ABS_LIBRARY_HOST=/mnt/user/media/youtube-podcasts
YT2ABS_TMP_HOST=/mnt/user/media/yt2abs-tmp
YT2ABS_DATA_HOST=./data
